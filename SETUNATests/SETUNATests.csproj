<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Kept in step with SETUNA.csproj: an OS-version-suffixed TFM would drag the 23 MB
         Windows SDK projection runtime pack into the self-contained test output too. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>SETUNATests</RootNamespace>
    <AssemblyName>SETUNATests</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <Platforms>x86;x64</Platforms>
    <LangVersion>latest</LangVersion>
    <PlatformTarget Condition="'$(Platform)' == 'x86'">x86</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' == 'x64'">x64</PlatformTarget>
    <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <!--
      The test host has to match the platform under test, and a RID-specific
      framework-dependent build needs a runtime of that architecture installed
      machine-wide: x86 otherwise dies with "hostfxr.dll could not be found".
      Bundling the runtime into the test output keeps the suite runnable for both
      platforms on a machine that only has the x64 runtime.
    -->
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="bin\**;obj\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SETUNA\SETUNA.csproj" />
  </ItemGroup>
</Project>
