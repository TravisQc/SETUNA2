<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Platforms>x86;x64</Platforms>
    <PlatformTarget Condition="'$(Platform)' == 'x86'">x86</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' == 'x64'">x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- Same reason as DialogRelayoutProbe: per-monitor-v2 is a process property granted by
         the manifest at process creation, so the probe borrows SETUNA's. -->
    <ApplicationManifest>..\..\SETUNA\app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFAC010;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SETUNA\SETUNA.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One list of "every dialog buildable without application state", shared with the
         synthetic ladder. Linked rather than duplicated: the two probes ask the same question
         of different mechanisms, and a dialog that exists for one but not the other is a
         coverage hole nobody would notice. A project reference is not an option — each probe is
         its own process precisely so its DPI awareness is its own. -->
    <Compile Include="..\DialogRelayoutProbe\Dialogs.cs" Link="Dialogs.cs" />
  </ItemGroup>
</Project>
