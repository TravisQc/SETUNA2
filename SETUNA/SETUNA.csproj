<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>SETUNA</RootNamespace>
    <AssemblyName>SETUNA</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>SETUNA.ico</ApplicationIcon>
    <StartupObject>SETUNA.Program</StartupObject>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <Platforms>x86;x64</Platforms>
    <LangVersion>latest</LangVersion>
    <PlatformTarget Condition="'$(Platform)' == 'x86'">x86</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' == 'x64'">x64</PlatformTarget>
    <!-- Restore both RIDs from one pass: the assets file is per project, not per
         platform, so a single-RID restore makes the other platform fail NETSDK1047. -->
    <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <DebugType Condition="'$(Configuration)' == 'Debug'">portable</DebugType>
    <DebugType Condition="'$(Configuration)' == 'Release'">pdbonly</DebugType>
    <!-- WFAC010 asks for the manifest's high-DPI settings to be replaced by
         ApplicationHighDpiMode. Declined on purpose: the manifest is applied by the OS
         at process creation, so monitor geometry is already correct for the splash and
         capture paths, and it cannot get separated from a single-file exe.
         ApplicationHighDpiMode stays set as the fallback, which is what makes the two
         look redundant to the analyzer. Measured with scripts/verify-dpi-awareness.ps1:
         the manifest wins the race and Application.SetHighDpiMode returns false. -->
    <!-- CA1416: Platform compatibility warnings suppressed because the project explicitly
         targets Windows (net8.0-windows10.0.17763.0) and all Windows-specific APIs used
         are guaranteed to be available on the minimum supported version. -->
    <NoWarn>$(NoWarn);WFAC010;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep the source boundary explicit so the project cannot silently pick up
         generated files or future build output. -->
    <Compile Include="**\*.cs" Exclude="bin\**;obj\**" />
    <EmbeddedResource Include="**\*.resx" Exclude="bin\**;obj\**">
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <EmbeddedResource Include="Plugins\libwebp_x86.dll" />
    <EmbeddedResource Include="Plugins\libwebp_x64.dll" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Prowl.Aperture" Version="3.3.0" />
    <PackageReference Include="Svg" Version="3.4.8" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
    </None>
  </ItemGroup>

  <!--
    Release publishing. The single-file properties deliberately do NOT live in the
    property group above: SelfContained=true at build time drags the whole runtime
    into bin\ and, through the test project's reference, into the test output as
    well. They are passed to a nested Publish instead, so `dotnet build` stays
    framework-dependent and fast while `PublishReleaseSingleFile` is the one
    documented way to produce a release artifact.
  -->
  <PropertyGroup>
    <ReleasePublishDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', 'publish'))</ReleasePublishDirectory>
    <ReleasePublishStagingDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', 'bin', 'publish', '$(Configuration)', '$(Platform)'))</ReleasePublishStagingDirectory>
    <ReleasePublishFile>$(ReleasePublishDirectory)$(AssemblyName)_$(Configuration)_$(Platform).exe</ReleasePublishFile>
  </PropertyGroup>

  <Target Name="PublishReleaseSingleFile">
    <Error Condition="'$(Platform)' != 'x86' AND '$(Platform)' != 'x64'" Text="PublishReleaseSingleFile needs -p:Platform=x86 or -p:Platform=x64; got '$(Platform)'. The runtime identifier is derived from it." />

    <!-- A clean staging directory, so validation cannot be fooled by a leftover
         companion file from an earlier publish and cannot pass because of one. -->
    <RemoveDir Directories="$(ReleasePublishStagingDirectory)" />

    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Publish" Properties="Configuration=$(Configuration);Platform=$(Platform);SelfContained=true;PublishSingleFile=true;IncludeNativeLibrariesForSelfExtract=true;EnableCompressionInSingleFile=true;PublishDir=$(ReleasePublishStagingDirectory)" />

    <CallTarget Targets="ValidateReleasePublishOutput" />

    <MakeDir Directories="$(ReleasePublishDirectory)" />
    <!-- The artifact is the exe itself, not a ZIP; the name carries configuration and
         platform so both architectures can sit in one directory. Copy overwrites, so
         the target is repeatable. -->
    <Copy SourceFiles="$(ReleasePublishStagingDirectory)$(AssemblyName).exe" DestinationFiles="$(ReleasePublishFile)" />
    <Message Importance="high" Text="Release artifact: $(ReleasePublishFile)" />
  </Target>

  <!--
    The single-file constraint's enforcement point. Nothing is deleted here: a stale
    artifact and a reintroduced configuration file both have to be looked at by a
    person, and quietly removing one would ship the other.
  -->
  <Target Name="ValidateReleasePublishOutput">
    <ItemGroup>
      <_ReleasePublishOutput Include="$(ReleasePublishStagingDirectory)**\*" />
      <_ReleasePublishExpected Include="@(_ReleasePublishOutput)" Condition="'%(Filename)%(Extension)' == '$(AssemblyName).exe' OR '%(Filename)%(Extension)' == '$(AssemblyName).pdb'" />
      <_ReleasePublishUnexpected Include="@(_ReleasePublishOutput)" Exclude="@(_ReleasePublishExpected)" />
      <_ReleasePublishConfig Include="@(_ReleasePublishUnexpected)" Condition="'%(Extension)' == '.config'" />
      <_ReleasePublishJson Include="@(_ReleasePublishUnexpected)" Condition="'%(Extension)' == '.json'" />
      <_ReleasePublishSatellite Include="@(_ReleasePublishUnexpected)" Condition="$([System.String]::Copy('%(Filename)').EndsWith('.resources'))" />
      <_ReleasePublishNative Include="@(_ReleasePublishUnexpected)" Condition="'%(Extension)' == '.dll'" />
      <_ReleasePublishArchive Include="@(_ReleasePublishUnexpected)" Condition="'%(Extension)' == '.zip' OR '%(Extension)' == '.7z' OR '%(Extension)' == '.rar'" />
    </ItemGroup>

    <Error Condition="!Exists('$(ReleasePublishStagingDirectory)$(AssemblyName).exe')" Text="Publish produced no $(AssemblyName).exe in $(ReleasePublishStagingDirectory)." />
    <Error Condition="'@(_ReleasePublishConfig)' != ''" Text="Application configuration file(s) in the publish output, which single-file distribution forbids: @(_ReleasePublishConfig). Either a stale artifact needs cleaning, or app.config / binding-redirect generation has been reintroduced." />
    <Error Condition="'@(_ReleasePublishJson)' != ''" Text="Runtime/dependency JSON companion(s) in the publish output: @(_ReleasePublishJson). A self-contained single file embeds both; their presence means PublishSingleFile or SelfContained did not take effect." />
    <Error Condition="'@(_ReleasePublishSatellite)' != ''" Text="Satellite resource assembly/assemblies in the publish output: @(_ReleasePublishSatellite). Localization goes through the embedded .resx tables, so a satellite means a dependency introduced culture-specific resources." />
    <Error Condition="'@(_ReleasePublishNative)' != ''" Text="Loose DLL(s) in the publish output: @(_ReleasePublishNative). Managed code is bundled and libwebp is extracted at runtime, so nothing may sit beside the exe." />
    <Error Condition="'@(_ReleasePublishArchive)' != ''" Text="Archive(s) in the publish output: @(_ReleasePublishArchive). The release artifact is the executable itself." />
    <Error Condition="'@(_ReleasePublishUnexpected)' != ''" Text="Unexpected file(s) in the publish output: @(_ReleasePublishUnexpected). Only $(AssemblyName).exe and its optional $(AssemblyName).pdb may be published." />
  </Target>
</Project>
